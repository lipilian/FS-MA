{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure TSFS (Release)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}/cpp",
        "-B",
        "${workspaceFolder}/cpp/build",
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build TSFS",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/cpp/build",
        "--parallel"
      ],
      "dependsOn": "Configure TSFS (Release)",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    }
  ]
}
