{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure TSFS (Release)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}/cpp",
        "-B",
        "${workspaceFolder}/cpp/build",
        "-G",
        "Unix Makefiles",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_CUDA_COMPILER=/usr/local/cuda-12.9/bin/nvcc",
        "-DCUDAToolkit_ROOT=/usr/local/cuda-12.9",
        "-DCMAKE_CUDA_ARCHITECTURES=120",
        "-DFS_BUILD_DESKTOP=OFF"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build TSFS",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/cpp/build",
        "--parallel",
        "4"
      ],
      "dependsOn": "Configure TSFS (Release)",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    }
  ]
}
